# ================== Servidor ==================
NODE_ENV=production
PORT=3000
# 127.0.0.1 si usás Nginx en el mismo VPS (recomendado). 0.0.0.0 dentro de Docker.
HOST=127.0.0.1
DB_PATH=./data/game.sqlite
PUBLIC_URL=https://juego.tudominio.com

# ================== Telegram ==================
# Token que te da @BotFather. NUNCA lo subas a GitHub.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Antigüedad máxima del initData en segundos (24h)
INITDATA_MAX_AGE=86400

# Sólo desarrollo: jugar en el navegador sin Telegram (se ignora si NODE_ENV=production)
DEV_AUTH=false

# ================== Anuncios ==================
# adsgram | mock  (mock = anuncio falso, prohibido en producción)
ADS_PROVIDER=adsgram
# ID del bloque "Reward" creado en https://partner.adsgram.ai
ADSGRAM_BLOCK_ID=
# true = Adsgram muestra anuncios de prueba (usalo hasta que aprueben tu app)
ADSGRAM_DEBUG=false
# Secreto largo y aleatorio. Va en la Reward URL del panel de Adsgram:
# https://juego.tudominio.com/api/ads/adsgram/reward?userid=[userId]&secret=ESTE_SECRETO
# Generalo con:  openssl rand -hex 24
ADSGRAM_REWARD_SECRET=
# Tope de anuncios recompensados por usuario cada 24h
ADS_DAILY_CAP=80
# Segundos mínimos entre pedir un anuncio y reclamar el premio
ADS_MIN_WATCH_SECONDS=4
